NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Largest file Settings → Upload accepts, in MB. Leave it a number: an empty value means 0 MB.
NEXT_PUBLIC_MAX_UPLOAD_MB=50
# Comma-separated Google emails allowed to sign in. Server-only. Never commit real values.
ALLOWED_EMAILS=
# Server-only. Base URL of the Reader backend the upload route forwards to.
READER_BACKEND_URL=
# Server-only. Both set: the ChatGPT connection is stored encrypted in Vercel Blob and shared
# with the hosted site, so copy the production values. Either unset: it stays in Web/.local/.
# AI_CREDENTIALS_KEY is 32 random bytes, base64 (openssl rand -base64 32).
AI_CREDENTIALS_KEY=
BLOB_READ_WRITE_TOKEN=
